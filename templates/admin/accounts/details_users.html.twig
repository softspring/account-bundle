{% trans_default_domain 'sfs_account' %}

<div class="bg-white p-4">
    <h4>Users</h4>

    {% if account is instanceof('Softspring\\AccountBundle\\Model\\AccountMembershipsInterface') %}
        <ul>
        {% for membership in account.memberships %}
            <li>
                {% if route_defined('sfs_user_admin_users_details') %}
                    <a href="{{ url('sfs_user_admin_users_details', {'user':membership.user}) }}">{{ membership.user.displayName }}</a>
                {% else %}
                    {{ membership.user.displayName }}
                {% endif %}

                {% if membership.grantedBy is defined and membership.grantedBy != membership.user %}
                    (granted by {{ membership.grantedBy.displayName }})
                {% endif %}
            </li>
        {% endfor %}
        </ul>
    {% endif %}
</div>
