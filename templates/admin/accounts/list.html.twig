{% trans_default_domain 'sfs_account' %}
{% extends '@SfsAccount/admin_layout.html.twig' %}

{% form_theme filter_form '@SfsComponents/forms/admin-horizontal.html.twig' %}

{% block title %}{{ 'admin_accounts.list.meta.title'|trans }}{% endblock %}

{% block breadcrums_content %}
    {{ parent() }}
    <li class="breadcrumb-item active" aria-current="page">{{ 'admin_accounts.list.breadcrumb'|trans }}</li>
{% endblock breadcrums_content %}

{% block content %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h3">{{ 'admin_accounts.list.title'|trans }}</h1>
        {% if is_granted('PERMISSION_SFS_ACCOUNT_ADMIN_ACCOUNTS_CREATE') %}
            <a href="{{ url('sfs_account_admin_accounts_create') }}" class="btn btn-primary">{{ 'admin_accounts.list.actions.create.link'|trans }}</a>
        {% endif %}
    </div>

    <div class="container-fluid bg-white p-4">
        {% if accounts|length %}
            <div class="mb-4">
                {{ form_start(filter_form) }}
                <div class="d-flex flex-wrap align-items-center gap-3">
                    {% if filter_form.name is defined %}{{ form_row(filter_form.name, {'row_class':'form-floating mb-3'}) }}{% endif %}
                    {% if filter_form.owner is defined %}{{ form_row(filter_form.owner, {'row_class':'form-floating mb-3'}) }}{% endif %}
                    {% if filter_form.search is defined %}{{ form_row(filter_form.search, {'row_class': 'form-floating mb-3'}) }}{% endif %}
                </div>
                {{ form_rest(filter_form) }}
                {{ form_end(filter_form) }}
            </div>
        {% endif %}

        {% set has_active_filters = filter_form.vars.submitted or filter_form.vars.data|default([])|filter(v => v) is not empty %}

        {% embed '@SfsComponents/paginator/table.html.twig' with {'collection': accounts, 'pagination_route': 'sfs_account_admin_accounts_list', 'has_active_filters': has_active_filters} only %}
            {% trans_default_domain 'sfs_account' %}

            {% block ths %}
                <th scope="col" class="p-3">
                    <a href="{{ collection.sortToggleUrl(app.request, 'name') }}" class="text-dark">
                        {{ 'admin_accounts.list.fields.name.header'|trans }}
                        {% if collection.sortedBy('name', 'asc') %}<i class="bi bi-caret-up-fill"></i>{% elseif collection.sortedBy('name', 'desc') %}<i class="bi bi-caret-down-fill"></i>{% endif %}
                    </a>
                </th>
                <th scope="col" class="p-3">{{ 'admin_accounts.list.fields.owner.header'|trans }}</th>
                <th>&nbsp;</th>
            {% endblock ths %}

            {% block tbody %}
                {% include '@SfsAccount/admin/accounts/list-page.html.twig' with {'accounts': collection} only %}
            {% endblock tbody %}

            {% block empty %}
                <div class="p-5 text-center">
                    <p class="mb-3 text-body-secondary">
                        {% if has_active_filters %}
                            {{ 'admin_accounts.list.no_matches'|trans }}
                        {% else %}
                            {{ 'admin_accounts.list.empty'|trans }}
                        {% endif %}
                    </p>
                    {% if is_granted('PERMISSION_SFS_ACCOUNT_ADMIN_ACCOUNTS_CREATE') %}
                        <a class="btn btn-link" href="{{ url('sfs_account_admin_accounts_create') }}">{{ 'admin_accounts.list.actions.create.link'|trans }}</a>
                    {% endif %}
                </div>
            {% endblock empty %}
        {% endembed %}
    </div>
{% endblock content %}
